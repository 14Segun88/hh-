# ==========================================
# HH.RU HARNESS AGENT CONFIGURATION (.env)
# ==========================================

# --- Tier 1: Local LM Studio (Qwen 2.5 7B / VL 7B) ---
# Running locally at http://localhost:1234/v1
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct
LM_STUDIO_TIMEOUT=60.0

# --- Tier 2: Remote NVIDIA NIM (Large Model, e.g. Llama 3.3 70B / Nemotron / R1) ---
# Get key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TIMEOUT=120.0

# --- Telegram Bot (Digests, Urgent Alerts, Inline Confirmations) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Agent Operation Parameters ---
# Mode: "semi_auto" (recommends & drafts in Telegram for review) or "auto" (submits directly)
APPLICATION_MODE=semi_auto

# Browser execution mode: set to false for first login, can be true for silent background runs
HEADLESS_BROWSER=false

# Minimum match score (0-100) from Qwen to trigger NIM deep dossier & consider applying
SCORE_THRESHOLD=70

# Max vacancies to evaluate per session batch (prevents rate-limits)
MAX_VACANCIES_PER_BATCH=40

# Window in hours to fetch vacancies (e.g. 48 for yesterday + today)
SEARCH_WINDOW_HOURS=48
