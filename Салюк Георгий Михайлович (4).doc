}\cell\pard\intbl\itap1{\fs50\b \uc0\u1057 \uc0\u1072 \uc0\u1083 \uc0\u1102 \uc0\u1082  \uc0\u1043 \uc0\u1077 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1080 \uc0\u1081  \uc0\u1052 \uc0\u1080 \uc0\u1093 \uc0\u1072 \uc0\u1081 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1095 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1052 \uc0\u1091 \uc0\u1078 \uc0\u1095 \uc0\u1080 \uc0\u1085 \uc0\u1072 , 27\uc0\u160 \uc0\u1083 \uc0\u1077 \uc0\u1090 , \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1089 \uc0\u1103  6 \uc0\u1089 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1103  1998}\par\pard\intbl\sl260{\fs18 \par +7\uc0\u160 (918)\uc0\u160 0452504 {\cf1\emdash  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073  \uc0\u1089 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1080 }\par {{\field{\*\fldinst HYPERLINK "mailto:d-saljuk@rambler.ru"}{\fldrslt\ul d-saljuk@rambler.ru}}}}\par\pard\intbl\sl260{\fs18 \par \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090 : \uc0\u1050 \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 , \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 \par \uc0\u1053 \uc0\u1077  \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1091 , \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1088 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1072 }\cell\row\trowd\cellx6861\clvertalt\cellx9638\pard\intbl\itap1\sa100\sl280{\fs24\b AI-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088  /\uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082  AI-\uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  /LLM-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 }\pard\intbl\itap1\sl260{\fs18 \par{\uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 :  }\par\li300{\uc0\u8212   \uc0\u1044 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1086 \uc0\u1077 }\par\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1058 \uc0\u1080 \uc0\u1087  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \par \uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1072 \uc0\u160 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 , \uc0\u1075 \uc0\u1080 \uc0\u1073 \uc0\u1088 \uc0\u1080 \uc0\u1076 , \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1105 \uc0\u1085 \uc0\u1085 \uc0\u1086 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1098 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1085 \uc0\u1072 \uc0\u1103 , \uc0\u1074 \uc0\u1072 \uc0\u1093 \uc0\u1090 \uc0\u1072 \par \line\uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1074  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1077  \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1077 \uc0\u1090  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }}\cell \pard\intbl\itap1\qr{\fs32\qc\b 220\uc0\u160 000\fs18\sl260  \uc0\u8381  \uc0\u1085 \uc0\u1072 \uc0\u160 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1080 }\par\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \emdash 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  5 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1071 \uc0\u1085 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1100  2023 \emdash  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1097 \uc0\u1077 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103 \line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  5 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\par\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1060 \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1090 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1071 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1083 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1100 }\par\pard\intbl\itap1\sl280\sb60\sa60{\fs24 ML-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \par}\pard\intbl\itap1\sl260\sa60{\fs18 News Predictor AI \uc0\u8212  Hybrid ML System for Financial Event Prediction{\line}\uc0\u128279  https://github.com/14Segun88/news-predictor-ai{\line}{\line}\uc0\u1043 \uc0\u1080 \uc0\u1073 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1085 \uc0\u1072 \uc0\u1103  ML-\uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074 \uc0\u1083 \uc0\u1080 \uc0\u1103 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1084 \uc0\u1072 \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1101 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1080 \uc0\u1081  (CPI, NFP, GDP) \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1102 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1099  EUR/USD/RUB.{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1103 \uc0\u1077 \uc0\u1090  3 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1089 \uc0\u1080 \uc0\u1075 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1074  \uc0\u8212  \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  (139 \uc0\u1092 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1081 ), knowledge base \uc0\u1080 \uc0\u1079  Investopedia/BabyPips (embeddings) \uc0\u1080  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1081 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1089 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090  \uc0\u8212  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  PyTorch Fusion Network + 4 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  CatBoost-\uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 .{\line}{\line}\uc0\u1063 \uc0\u1090 \uc0\u1086  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 :{\line}\uc0\u128200  \uc0\u1057 \uc0\u1073 \uc0\u1086 \uc0\u1088  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089  investing.com (Playwright) + \uc0\u1088 \uc0\u1099 \uc0\u1085 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  yfinance (RSI, VIX, DXY){\line}\uc0\u129529  Feature Engineering \uc0\u8212  139 \uc0\u1092 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1081 : delta \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079 \uc0\u1086 \uc0\u1074 , \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099 , \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 {\line}\uc0\u128218  Knowledge Base \uc0\u8212  embeddings \uc0\u1080 \uc0\u1079  \uc0\u1092 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1082 \uc0\u1085 \uc0\u1080 \uc0\u1075  (Investopedia, BabyPips) \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  sentence-transformers{\line}\uc0\u129504  4\uc0\u215  CatBoost \uc0\u8212  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080  (currency / percent / jobs / index events){\line}\uc0\u128293  PyTorch Fusion Network \uc0\u8212  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1103 \uc0\u1077 \uc0\u1090  CatBoost-\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079 \uc0\u1099  + book embeddings + trader sentiment{\line}\uc0\u129302  Telegram-\uc0\u1073 \uc0\u1086 \uc0\u1090  \uc0\u8212  \uc0\u1086 \uc0\u1090 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1100  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u8594  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079  UP/DOWN \uc0\u1089  % \uc0\u1091 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1091 \uc0\u1085 \uc0\u1076 \uc0\u1099 {\line}\uc0\u1050 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1080 :{\line}7 865 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1080 \uc0\u1081  \uc0\u1074  \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1102 \uc0\u1097 \uc0\u1077 \uc0\u1081  \uc0\u1074 \uc0\u1099 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1082 \uc0\u1077 {\line}54.16% overall accuracy (baseline 50% \uc0\u1085 \uc0\u1072  \uc0\u1101 \uc0\u1092 \uc0\u1092 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1088 \uc0\u1099 \uc0\u1085 \uc0\u1082 \uc0\u1077  \uc0\u8212  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1090  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1075 \uc0\u1085 \uc0\u1072 \uc0\u1083 ){\line}85.7% accuracy \uc0\u1087 \uc0\u1088 \uc0\u1080  confidence >65% \uc0\u8212  actionable \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1080 {\line}Precision over recall \uc0\u8212  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1086 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1086 \uc0\u1079 \uc0\u1086 \uc0\u1074  \uc0\u1089  \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1091 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \uc0\u1102 {\line}ML-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}LayerNorm \uc0\u183  AdamW \uc0\u183  Cosine Annealing LR \uc0\u183  gradient clipping \uc0\u183  time-based split (\uc0\u1073 \uc0\u1077 \uc0\u1079  data leakage){\line}{\line}\uc0\u1057 \uc0\u1090 \uc0\u1077 \uc0\u1082 : Python \uc0\u183  PyTorch \uc0\u183  CatBoost \uc0\u183  sentence-transformers \uc0\u183  Playwright \uc0\u183  aiogram \uc0\u183  Telegram Bot API}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1071 \uc0\u1085 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1100  2025 \emdash  \uc0\u1040 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1083 \uc0\u1100  2026\line 1 \uc0\u1075 \uc0\u1086 \uc0\u1076  4 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1072 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1052 \uc0\u1054 \uc0\u1043 \uc0\u1069 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , www.moexp.ru/}\par{\fs18 \uc0\u1059 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1075 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1072 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1100  \uc0\u1082 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 , \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 , \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 AI-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \par}\pard\intbl\itap1\sl260\sa60{\fs18 PD Document Analyzer \uc0\u8212  AI-Powered 8-Field Extraction with CoT Reasoning{\line}\uc0\u128279  https://github.com/14Segun88/pd-document-analyzer{\line}{\line}\uc0\u1042 \uc0\u1077 \uc0\u1073 -\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  \uc0\u8212  \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  8 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1081  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080 \uc0\u1079  PDF \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1097 \uc0\u1100 \uc0\u1102  LLM \uc0\u1080  Chain-of-Thought reasoning.{\line}{\line}7-\uc0\u1096 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  CoT-\uc0\u1087 \uc0\u1072 \uc0\u1081 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085  \uc0\u1089  Knowledge Base \uc0\u1085 \uc0\u1072  49 \uc0\u1090 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1074  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082 \uc0\u1072 \uc0\u1087 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 . \uc0\u1040 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1072  CoT-fallback: \uc0\u1089 \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1083 \uc0\u1072  LLM-\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 , \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1084  KB-matching \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u8212  \uc0\u1085 \uc0\u1072  known documents \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  100%.{\line}{\line}\uc0\u1063 \uc0\u1090 \uc0\u1086  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 :{\line}\uc0\u128196  \uc0\u1048 \uc0\u1079 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1090 \uc0\u1072  \uc0\u1080 \uc0\u1079  PDF \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  PyMuPDF (\uc0\u1074 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1099 ){\line}\uc0\u129504  7-\uc0\u1096 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  CoT-\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  Mistral 14B Reasoning:{\line}\uc0\u1054 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1090 \uc0\u1080 \uc0\u1087  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 {\line}\uc0\u1048 \uc0\u1079 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1100  \uc0\u1085 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 {\line}\uc0\u1053 \uc0\u1072 \uc0\u1081 \uc0\u1090 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 {\line}\uc0\u1053 \uc0\u1072 \uc0\u1081 \uc0\u1090 \uc0\u1080  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 {\line}\uc0\u1054 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1075 \uc0\u1086 \uc0\u1076 {\line}\uc0\u1048 \uc0\u1079 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1100  \uc0\u1089 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 {\line}\uc0\u1054 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1100 {\line}\uc0\u128218  Knowledge Base matching \uc0\u8212  49 \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082 \uc0\u1072 \uc0\u1087 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 , \uc0\u1087 \uc0\u1088 \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1087 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u8594  override LLM-\uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1072  (100% accuracy){\line}\uc0\u127760  Flask \uc0\u1074 \uc0\u1077 \uc0\u1073 -\uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1077 \uc0\u1081 \uc0\u1089  \uc0\u8212  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1080 \uc0\u1083  PDF \uc0\u8594  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1083  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077 {\line}\uc0\u128202  \uc0\u1041 \uc0\u1077 \uc0\u1085 \uc0\u1095 \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1082 \uc0\u1080  \uc0\u8212  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077  \uc0\u1089 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  V5 vs V6, semantic scoring, cross-model evaluation{\line}\uc0\u1050 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1080 :{\line}Accuracy V5 \uc0\u8594  V6: 30% \uc0\u8594  80% (+50 \uc0\u1087 .\uc0\u1087 ., \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1090  \uc0\u215 2.67){\line}100% accuracy \uc0\u1085 \uc0\u1072  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1093  \uc0\u1080 \uc0\u1079  Knowledge Base{\line}94 \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1074 \uc0\u1099 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1082 \uc0\u1077 {\line}8 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1081  (\uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 , \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 , \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 , \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 , \uc0\u1075 \uc0\u1086 \uc0\u1076 , \uc0\u1090 \uc0\u1080 \uc0\u1087 , \uc0\u1089 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1100 ){\line}Multi-version architecture \uc0\u8212  \uc0\u1101 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1102 \uc0\u1094 \uc0\u1080 \uc0\u1103  V2 \uc0\u8594  V3 \uc0\u8594  V4 \uc0\u8594  V6{\line}Production-ready:{\line}\uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1089  \uc0\u1083 \uc0\u1102 \uc0\u1073 \uc0\u1099 \uc0\u1084  OpenAI-compatible endpoint (Groq, OpenAI, NVIDIA NIM). LM Studio \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1091 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1083 \uc0\u1086 \uc0\u1082 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1080  offline-\uc0\u1088 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1072 .{\line}{\line}\uc0\u1057 \uc0\u1090 \uc0\u1077 \uc0\u1082 : Python \uc0\u183  Flask \uc0\u183  Mistral 14B \uc0\u183  PyMuPDF \uc0\u183  LM Studio \uc0\u183  Knowledge Base (JSON)}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1060 \uc0\u1077 \uc0\u1074 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1100  2023 \emdash  \uc0\u1060 \uc0\u1077 \uc0\u1074 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1100  2026\line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  1 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1043 \uc0\u1040 \uc0\u1059  \uc0\u1052 \uc0\u1054  \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 }\par\pard\intbl\itap1\sl280\sb60\sa60{\fs24 ML-\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \par}\pard\intbl\itap1\sl260\sa60{\fs18 MOGE \uc0\u8212  AI Document Expertise System{\line}\uc0\u128279  https://github.com/14Segun88/moge-document-expertise-ai{\line}{\line}\uc0\u1052 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 -\uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1085 \uc0\u1072 \uc0\u1103  AI-\uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1099  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1054 \uc0\u1073 \uc0\u1083 \uc0\u1043 \uc0\u1086 \uc0\u1089 \uc0\u1069 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1099 .{\line}{\line}8 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  AI-\uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1089  \uc0\u1086 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1084  \uc0\u1085 \uc0\u1072  Llama-3.3-70B \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102 \uc0\u1090  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  (PDF, XML, \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1080 ) \uc0\u1079 \uc0\u1072  5\uc0\u8211 10 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1090  \uc0\u1074 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086  12\uc0\u8211 42 \uc0\u1076 \uc0\u1085 \uc0\u1077 \uc0\u1081  \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1072 .{\line}{\line}\uc0\u1063 \uc0\u1090 \uc0\u1086  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 :{\line}\uc0\u128203  \uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1080  (FC-001..FC-005): \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  XML \uc0\u1087 \uc0\u1086  XSD-\uc0\u1089 \uc0\u1093 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1084 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1072  \uc0\u1048 \uc0\u1059 \uc0\u1051 , \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 , DPI \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 {\line}\uc0\u128269  \uc0\u1050 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1089 -\uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1058 \uc0\u1069 \uc0\u1055  \uc0\u1087 \uc0\u1086  \uc0\u1055 \uc0\u1055  \uc0\u1056 \uc0\u1060  \uc0\u8470 963 \uc0\u1080  \uc0\u8470 154{\line}\uc0\u128202  \uc0\u1057 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1072  \uc0\u1058 \uc0\u1047  \uc0\u1080  \uc0\u1055 \uc0\u1047  \uc0\u1087 \uc0\u1086  \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1083 \uc0\u1080 \uc0\u1094 \uc0\u1077  \uc0\u1082 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1077 \uc0\u1074  \uc0\u1095 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1079  LLM{\line}\uc0\u127760  \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1072  \uc0\u1043 \uc0\u1048 \uc0\u1055  \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1077  \uc0\u1053 \uc0\u1054 \uc0\u1055 \uc0\u1056 \uc0\u1048 \uc0\u1047  (headless Playwright){\line}\uc0\u128218  RAG-\uc0\u1087 \uc0\u1072 \uc0\u1081 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085  \uc0\u8212  \uc0\u1075 \uc0\u1080 \uc0\u1073 \uc0\u1088 \uc0\u1080 \uc0\u1076 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082  (BM25 + Vector) \uc0\u1087 \uc0\u1086  20+ \uc0\u1085 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1084  \uc0\u1074  Weaviate{\line}\uc0\u128196  PDF-\uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086  \uc0\u1043 \uc0\u1054 \uc0\u1057 \uc0\u1058  \uc0\u1056  7.0.97-2016{\line}\uc0\u129302  Telegram-\uc0\u1073 \uc0\u1086 \uc0\u1090  \uc0\u8212  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1080 \uc0\u1083  ZIP \uc0\u8594  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1083  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 {\line}\uc0\u1050 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1080 :{\line}100+ \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1055 \uc0\u1044  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086  \uc0\u1074  production (2024\uc0\u8211 2026){\line}8 AI-\uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1089  \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1084 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1096 \uc0\u1088 \uc0\u1091 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1077 \uc0\u1081 {\line}QLoRA fine-tuning pipeline (Qwen2.5-3B \uc0\u8594  GGUF, \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1085 \uc0\u1072  \uc0\u1076 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 ){\line}\uc0\u1057 \uc0\u1090 \uc0\u1077 \uc0\u1082 : Python \uc0\u183  FastAPI \uc0\u183  Groq Cloud \uc0\u183  Weaviate \uc0\u183  Docker \uc0\u183  Playwright \uc0\u183  Telegram Bot API}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1059 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1100 }\cell\pard\intbl\itap1\pard\intbl\itap1\sl260{\fs18 \uc0\u1057 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1077 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\par\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1086 \uc0\u1074 }\cell\pard\intbl\itap1\sl260{\fs18 \uc0\u1056 \uc0\u1091 \uc0\u1089 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  \uc0\u1056 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081 }}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\pard\intbl\itap1\sb250\sl260{\fs18 {\cb5\chcfpat5\chcbpat5 LLM}  {\cb5\chcfpat5\chcbpat5 \uc0\u1041 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1080 \uc0\u1077 \~\uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1077 \~\uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 Prompt\~Engineering}  {\cb5\chcfpat5\chcbpat5 RAG}  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1090 -\uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 }  {\cb5\chcfpat5\chcbpat5 Retrieval-Augmented\~Generation}  {\cb5\chcfpat5\chcbpat5 Multi-Agent\~Systems}  {\cb5\chcfpat5\chcbpat5 \uc0\u1052 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 -\uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1077 \~\uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099 }  {\cb5\chcfpat5\chcbpat5 AI\~Agents}  {\cb5\chcfpat5\chcbpat5 LangChain}  {\cb5\chcfpat5\chcbpat5 Llama}  {\cb5\chcfpat5\chcbpat5 GPT-4}  {\cb5\chcfpat5\chcbpat5 Groq}  {\cb5\chcfpat5\chcbpat5 OpenAI\~API}  {\cb5\chcfpat5\chcbpat5 Hugging\~Face}  {\cb5\chcfpat5\chcbpat5 Mistral}  {\cb5\chcfpat5\chcbpat5 Vector\~Database}  {\cb5\chcfpat5\chcbpat5 Weaviate}  {\cb5\chcfpat5\chcbpat5 Embeddings}  {\cb5\chcfpat5\chcbpat5 sentence-transformers}  {\cb5\chcfpat5\chcbpat5 Python}  {\cb5\chcfpat5\chcbpat5 FastAPI}  {\cb5\chcfpat5\chcbpat5 asyncio}  {\cb5\chcfpat5\chcbpat5 PyTorch}  {\cb5\chcfpat5\chcbpat5 SQLAlchemy}  {\cb5\chcfpat5\chcbpat5 Docker}  {\cb5\chcfpat5\chcbpat5 Linux}  {\cb5\chcfpat5\chcbpat5 Git}  {\cb5\chcfpat5\chcbpat5 Playwright}  {\cb5\chcfpat5\chcbpat5 REST\~API}}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa100\sl280{\fs18\uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072  \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1080  A}\cell\row\pard}